# Template only. Put real values in Vercel Project Settings, never in Git.
APP_URL=https://www.instantmemeeditandpost.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Off by default in production (including previews); use true to enable signup.
SIGNUP_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipmemeeditor-clips
INSTAGRAM_AUTH_MODE=instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_STATE_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_REDIRECT_URI=https://www.instantmemeeditandpost.online/api/instagram/callback
# Leave off for initial deployment. Enable external or vercel only after setup.
INSTAGRAM_SCHEDULER_MODE=disabled
INSTAGRAM_SCHEDULER_ENABLED=false
INSTAGRAM_CRON_SECRET=
# Required for built-in Vercel Cron; use the SAME value as INSTAGRAM_CRON_SECRET.
CRON_SECRET=
# Set explicitly to activation time in UTC, then retain across redeployments.
INSTAGRAM_SCHEDULER_NOT_BEFORE=
# Maximum posts processed concurrently in one tick, across ALL users (1-20).
INSTAGRAM_SCHEDULER_BATCH_SIZE=10
# Optional English transcription provider.
GROQ_API_KEY=
